# Copy to .env (`cp .env.example .env`) and fill in. Never commit .env.
# docker-compose overrides DATABASE_URL / REDIS_URL / STORAGE_DIR for containers;
# the values below are for running backend commands on the host (e.g. `make test`).

ENV=development
DATABASE_URL=postgresql+asyncpg://sherlock:sherlock@localhost:5433/sherlock
REDIS_URL=redis://localhost:6380/0
STORAGE_DIR=./data/files
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
DEV_AUTH=true            # local only; refused when ENV=production
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=             # signs the session cookie
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
ADMIN_EMAILS=[]          # JSON list, e.g. ["you@gmail.com"]: may always sign in, and are admins

# Run the whole app with fake LLM/embedder/contacts/Gmail/job sources (no API keys needed).
USE_FAKES=true

LLM_PROVIDER=gemini
GEMINI_API_KEY=          # owner's key: shared work + onboarding fallback
LLM_MODEL_SMART=gemini-3.8-flash         # pinned 2026-10-04: newest stable Flash on the free tier
LLM_MODEL_FAST=gemini-3.5-flash-lite     # pinned 2026-10-04: newest stable Flash-Lite on the free tier
LLM_RPM=4                # per key AND per model; free limit seen in AI Studio is 5 (Gemini 2.5 Flash)
LLM_RPD=18               # per key AND per model; free limit is 20; resets midnight US Pacific
ALLOW_OWNER_KEY_FALLBACK=false
ANTHROPIC_API_KEY=       # optional, only if LLM_PROVIDER=anthropic

HN_ENABLED=true          # parse HN "Who is hiring" (owner's key; needs USE_FAKES=false)

EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_MIN_SIM=0.6
# Matching (Phase 3): batched fast-model scoring requests per user per rolling 24h, jobs per request,
# and how many of the most similar unscored jobs each run considers.
MATCH_DAILY_LLM_CALLS=6
MATCH_BATCH_SIZE=10
MATCH_CANDIDATES_PER_RUN=50
# Open outreach (Phase 8): companies are scored the same way, under their own smaller allowance.
COMPANY_MATCH_DAILY_LLM_CALLS=3
COMPANY_MATCH_BATCH_SIZE=8
COMPANY_CANDIDATES_PER_RUN=24

HUNTER_API_KEY=
# Each user adds their own Hunter key in Settings (free plan ~50 credits/month per account).
# The owner's HUNTER_API_KEY is used for users without one only if this is true.
ALLOW_OWNER_HUNTER_FALLBACK=false
CONTACT_CACHE_DAYS=60
# Apollo is optional and per user (Settings → Apollo): free accounts need a work email for search.
# Companies for open outreach come from the public YC directory, no key needed.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Per-user monthly quotas (Phase 9). Over either one, a user's drafting, matching and lookups stop
# until the 1st of next month (UTC); approved emails still go out.
MAX_CONTACT_LOOKUPS_PER_USER_MONTH=40
MAX_LLM_USD_PER_USER_MONTH=5
# Estimated cost of one LLM request, for the quota above and the admin page. 0 on Gemini's free tier.
LLM_USD_PER_CALL=0

# API rate limit per signed-in user (per IP otherwise): a burst, refilled per minute.
API_RATE_LIMIT_ENABLED=true
API_RATE_PER_MINUTE=120
API_RATE_BURST=60

# Logs are JSON lines when LOG_JSON=true or ENV=production.
LOG_JSON=false
# Optional error reporting; leave empty to keep Sentry off.
SENTRY_DSN=
